{
	"name": "kohls-admin",
	"emitLegacyScripts": false,
	"globIgnorePaths": ["**/*.spec.lua", "**/*.spec.luau", "**/ThumbnailCamera.model.json"],
	"tree": {
		"$path": "src",
		"Flux": { "$path": "vendor/flux" },
		"Z": { "$path": "vendor/z" },
		"VERSION": { "$path": "VERSION.txt" },
		"Server": {
			"$path": "src/Server",
			"Tools": {
				"$className": "Folder",
				"Building Tools": {
					"$path": "vendor/f3x",
					"$properties": {
						"Tags": ["_K_Ignore"]
					}
				}
			}
		}
	}
}
