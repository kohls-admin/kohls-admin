{
	"name": "MainModule",
	"emitLegacyScripts": false,
	"globIgnorePaths": ["**/*.spec.lua", "**/*.spec.luau", "**/ThumbnailCamera.model.json"],
	"tree": {
		"$path": "../test/migrate",
		"KA": {
			"$path": "../src",
			"Flux": { "$path": "../vendor/flux" },
			"Z": { "$path": "../vendor/z" },
			"VERSION": { "$path": "../VERSION.txt" }
		},
		"Tools": {
			"$className": "Folder",
			"Building Tools": {
				"$path": "../vendor/f3x",
				"$properties": {
					"Tags": ["_K_Ignore"]
				}
			}
		}
	}
}
