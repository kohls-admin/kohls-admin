{
	"name": "Kohl's Admin",
	"emitLegacyScripts": false,
	"tree": {
		"$className": "Model",
		"Config": {
			"$path": "../model/Config"
		},
		"Loader": {
			"$path": "../model/Loader.server.luau",
			"MainModule": {
				"$path": "../src",
				"Flux": {
					"$path": "../vendor/flux"
				},
				"Z": {
					"$path": "../vendor/z"
				},
				"VERSION": {
					"$path": "../VERSION.txt"
				}
			},
			"Tools": {
				"$className": "Folder",
				"Building Tools": {
					"$path": "../vendor/f3x",
					"$properties": {
						"Tags": ["_K_Ignore"]
					}
				}
			}
		},
		"README": {
			"$path": "../model/README.luau"
		},
		"ThumbnailCamera": {
			"$path": "../model/ThumbnailCamera.model.json"
		},
		"LICENSE": {
			"$path": "../LICENSE.txt"
		}
	}
}
