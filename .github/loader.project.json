{
	"name": "Kohl's Admin",
	"emitLegacyScripts": false,
	"tree": {
		"$className": "Model",
		"Config": {
			"$path": "../model/Config"
		},
		"Loader": {
			"$path": "../model/Loader.server.luau",
			"MainModule": {
				"$path": "../src",
				"Flux": {
					"$path": "../submodules/Flux"
				},
				"Z": {
					"$path": "../submodules/Z"
				},
				"VERSION": {
					"$path": "../VERSION.txt"
				}
			},
			"Tools": {
				"$className": "Folder",
				"Building Tools": {
					"$path": "../submodules/F3X",
					"$properties": {
						"Tags": ["_K_Ignore"]
					}
				}
			}
		},
		"README": {
			"$path": "../model/README.luau"
		},
		"ThumbnailCamera": {
			"$path": "../model/ThumbnailCamera.model.json"
		},
		"LICENSE": {
			"$path": "../LICENSE.txt"
		}
	}
}
