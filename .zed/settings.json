{
	"lsp": {
		"luau-lsp": {
			"settings": {
				"roblox": {
					"enabled": true,
					"security_level": "roblox_script",
				},
				"fflags": {
					"enable_new_solver": true,
				},
				"luau-lsp": {
					"sourcemap": {
						"enabled": true,
						"autogenerate": true,
						"rojoProjectFile": "test/default.project.json",
						"includeNonScripts": true,
					},
					"diagnostics": {
						"workspace": true,
					},
				},
			},
		},
	},
	"languages": {
		"Luau": {
			"formatter": {
				"external": {
					"command": "stylua",
					"arguments": [
						"--search-parent-directories",
						"--stdin-filepath",
						"{buffer_path}",
						"-",
					],
				},
			},
		},
	},
}
